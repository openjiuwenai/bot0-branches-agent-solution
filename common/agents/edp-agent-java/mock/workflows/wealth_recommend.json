{
  "id": "wealth_recommend",
  "description": "推荐理财产品（对齐 AgentEnvExplorer winvest_rec_05，首轮直达产品列表）",
  "priority": 30,
  "match": {
    "type": "query",
    "rules": [
      {
        "kind": "exclude_all",
        "patterns": ["理财产品：产品名称：", "产品代码：", "金额："]
      },
      {
        "kind": "keywords",
        "any": ["推荐", "理财", "产品", "我要买理财"],
        "case_insensitive": false
      }
    ]
  },
  "output": {
    "omit_end": true,
    "frames": [
      { "kind": "raw_json", "hook": "wealth_rec_qa_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "wealth_rec_qa_summary_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "wealth_rec_gxz_qa_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "wealth_rec_gxz_summary_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "wealth_rec_query_end_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "wealth_rec_event_end_frame", "delay_ms": 0 }
    ]
  }
}
