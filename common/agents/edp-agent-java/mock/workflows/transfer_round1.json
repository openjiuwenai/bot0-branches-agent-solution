{
  "id": "transfer_round1",
  "description": "转账首轮：返回确认提示卡片（Custom + menu_type=TRANSFER_MENU），不含 End 和 GXZQAResponseNode，触发 input_required 中断",
  "priority": 50,
  "match": {
    "type": "query",
    "rules": [
      {
        "kind": "keywords",
        "any": ["转账", "transfer", "汇款", "汇钱", "转钱"],
        "case_insensitive": true
      }
    ]
  },
  "output": {
    "omit_end": true,
    "frames": [
      { "kind": "raw_json", "hook": "transfer_confirm_menu_frame", "delay_ms": 50 }
    ]
  }
}
