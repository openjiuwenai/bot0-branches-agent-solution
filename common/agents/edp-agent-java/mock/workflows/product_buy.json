{
  "id": "product_buy",
  "description": "理财产品购买签署（对齐 AgentEnvExplorer winvest_buy，首轮直达）",
  "priority": 90,
  "match": {
    "type": "query",
    "rules": [
      {
        "kind": "keywords_all",
        "all": ["理财产品：产品名称：", "产品代码：", "金额："]
      }
    ]
  },
  "output": {
    "omit_end": true,
    "frames": [
      { "kind": "raw_json", "hook": "product_buy_questioner_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "product_buy_gxz_qa_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "product_buy_gxz_summary_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "product_buy_query_end_frame", "delay_ms": 50 },
      { "kind": "raw_json", "hook": "product_buy_event_end_frame", "delay_ms": 0 }
    ]
  }
}
