# Versatile mock independent Docker deployment configuration.
# Copy to deploy/.env before first start. Format: KEY=value, without quotes or spaces around '='.

# Deployment controls.
MOCK_IMAGE=versatile-mock:1.0.0
MOCK_CONTAINER_NAME=versatile-mock
AGENT_NETWORK=agent-net
MOCK_NETWORK_ALIAS=versatile-mock
RESTART_POLICY=unless-stopped
MOCK_PIP_INDEX_URL=https://pypi.org/simple

# Host port publication is unnecessary for adapter-to-mock traffic.
# false: do not publish; true: publish MOCK_HOST_BIND:MOCK_HOST_PORT for host/cross-host debugging.
MOCK_PUBLISH_PORT=false
MOCK_HOST_BIND=127.0.0.1
MOCK_HOST_PORT=30001

# Mock behavior. Container listen host/port are deliberately fixed to 0.0.0.0:30001 by start.sh.
MOCK_SKIP_COOKIE_AUTH=true
MOCK_BALANCE_DELAY_SECONDS=0
MOCK_TRANSFER_AMOUNTS=
MOCK_TRANSFER_MODE=cycle
MOCK_LICAI_BALANCE=1000.0
MOCK_CHUXU_BALANCE=125680.5
MOCK_SAME_CARD_MODE=false
MOCK_BALANCE_SAME_CARD=false
MOCK_PRODUCT_BUY_SUCCESS=true

