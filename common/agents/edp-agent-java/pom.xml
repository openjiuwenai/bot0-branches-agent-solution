<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>com.openjiuwen</groupId>
  <artifactId>edp-agent-java</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>edp-agent-java</name>
  <description>Production EDPAgent Java project — engine, scenarios, deploy, tests.</description>

  <url>https://gitcode.com/openJiuwen/agent-solution</url>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>liubin</id>
      <name>liubin</name>
      <email>nickylba.liubin@huawei.com</email>
    </developer>
  </developers>
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://gitcode.com/openJiuwen/agent-solution.git</connection>
    <developerConnection>scm:git:git@gitcode.com:openJiuwen/agent-solution.git</developerConnection>
    <url>https://gitcode.com/openJiuwen/agent-solution</url>
  </scm>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <agent-runtime-java.version>0.1.2</agent-runtime-java.version>
    <agent-runtime-ext-java.version>0.1.0</agent-runtime-ext-java.version>
    <!--
      必须使用为 JDK 17 发布的 agent-core-java（class 文件 major version 61，含
      harness.deep_agent、core.singleagent.interrupt 及新版 BaseInterruptRail API）。
      0.1.14 为 JDK17 正式构建。切勿改用旧的裸 0.1.12（部分仓库为缺包的旧构建），
      会导致 agentcore-ext 编译失败。
    -->
    <agent-core-java.version>0.1.15</agent-core-java.version>
    <!-- A 桶：覆盖 Boot 4.0.7 BOM 属性以对齐 core 830（机制同 agent-runtime-java develop；
         各 deliverable parent 须各自声明，Maven 属性不跨 reactor 传递） -->
    <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
    <opentelemetry.version>1.64.0</opentelemetry.version>
    <pulsar.version>4.2.3</pulsar.version>
    <mockito.version>5.14.2</mockito.version>
    <byte-buddy.version>1.15.11</byte-buddy.version>
    <snakeyaml.version>2.2</snakeyaml.version>
    <slf4j.version>2.0.12</slf4j.version>
    <logback.version>1.5.37</logback.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <commons-codec.version>1.20.0</commons-codec.version>
    <postgresql.version>42.7.12</postgresql.version>
    <mysql.version>9.7.0</mysql.version>
    <h2.version>2.2.224</h2.version>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <lombok.version>1.18.32</lombok.version>
    <log4j2.version>2.26.1</log4j2.version>
    <kotlin.version>2.4.10</kotlin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- C 桶：Boot 不管/管理值非 core，显式 pin 防漂移（同 agent-runtime-ext-java） -->
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>2.11.0</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>4.33.2</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>4.33.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>engine</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>net.revelc.code.formatter</groupId>
        <artifactId>formatter-maven-plugin</artifactId>
        <version>2.23.0</version>
        <configuration>
          <configFile>${project.parent.basedir}/../.devtools/eclipse-java-formatter.xml</configFile>
          <includes>
            <include>**/*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
      central-release: activate with -Pcentral-release to attach -sources/-javadoc jars and
      GPG-sign all artifacts for manual upload to Maven Central. Not active by default (GPG
      would prompt on every build). Duplicated across the four publishing poms because they
      share no common internal parent by design — bump plugin versions in all four together.
  -->
  <profiles>
    <profile>
      <id>central-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.7.0</version>
            <configuration>
              <encoding>UTF-8</encoding>
              <charset>UTF-8</charset>
              <docencoding>UTF-8</docencoding>
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
