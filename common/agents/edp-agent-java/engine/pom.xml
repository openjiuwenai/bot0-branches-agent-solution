<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.openjiuwen</groupId>
    <artifactId>edp-agent-java</artifactId>
    <version>0.1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>edp-agent-engine</artifactId>
  <name>edp-agent-engine</name>
  <description>Production EDPAgent engine powered by OpenJiuwen DeepAgent and agent-runtime.</description>
  <dependencies>
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-service-app</artifactId>
      <version>${agent-runtime-java.version}</version>
    </dependency>
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-service-adapters-agentcore-ext</artifactId>
      <version>${agent-runtime-ext-java.version}</version>
      <exclusions>
        <exclusion>
          <groupId>com.openjiuwen</groupId>
          <artifactId>agent-core-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-otlp</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-core-java</artifactId>
      <version>${agent-core-java.version}</version>
      <exclusions>
        <!-- ========== A 组：RAG/检索相关 ========== -->
        <exclusion>
          <groupId>org.apache.poi</groupId>
          <artifactId>poi-ooxml</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.milvus</groupId>
          <artifactId>milvus-sdk-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.alibaba</groupId>
          <artifactId>dashscope-sdk-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.pdfbox</groupId>
          <artifactId>pdfbox</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.pgvector</groupId>
          <artifactId>pgvector</artifactId>
        </exclusion>
        <!-- ========== B 组：Memory 相关 ========== -->
        <exclusion>
          <groupId>org.bouncycastle</groupId>
          <artifactId>bcprov-jdk18on</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.bouncycastle</groupId>
          <artifactId>bcpkix-jdk18on</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.bouncycastle</groupId>
          <artifactId>bcutil-jdk18on</artifactId>
        </exclusion>
        <!-- ========== C 组：其他重型依赖 ========== -->
        <exclusion>
          <groupId>org.apache.pulsar</groupId>
          <artifactId>pulsar-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.grpc</groupId>
          <artifactId>grpc-netty-shaded</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.xerial</groupId>
          <artifactId>sqlite-jdbc</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.openai</groupId>
          <artifactId>openai-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-otlp</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-sender-grpc-managed-channel</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- DFX-001 OTel 轨迹上报（runtime ext middleware/otel）运行时必需。
         禁止排除/删除：缺失时 otel.enabled=true 启动即 NoClassDefFoundError。
         opentelemetry-exporter-sender-jdk / sender-grpc-managed-channel 由本依赖传递引入，无需单独声明。 -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!--
      agent-core-java 的发布 POM 已声明 jedis 5.1.5 为 compile 依赖，
      且未在上方 exclusion 列表中排除，会通过传递依赖正常引入，无需显式补充。
      agent-core 的 RedisKVStoreProvider 通过反射创建 redis.clients.jedis.Jedis / JedisCluster。
    -->
    <!--
      agent-core-java 的发布 POM 已声明 okhttp 4.12.0 为 compile 依赖，
      且未在上方 exclusion 列表中排除，会通过传递依赖正常引入，无需显式补充。
      agent-core-java 的 LLM 客户端（OpenAiCompatibleModelClient 等）通过 OkHttp 调用 LLM。
    -->
    <!-- milvus 链路把 okio 拉到 3.6.0，与 otlp okhttp sender 所需的 3.16+ API 冲突，显式 pin -->
    <dependency>
      <groupId>com.squareup.okio</groupId>
      <artifactId>okio-jvm</artifactId>
      <version>3.16.4</version>
    </dependency>
    <dependency>
      <groupId>com.squareup.okio</groupId>
      <artifactId>okio</artifactId>
      <version>3.16.4</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.26.0</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.openjiuwen.edp.EdpApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
