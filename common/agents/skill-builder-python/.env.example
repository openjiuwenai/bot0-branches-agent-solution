# 必需的 OpenAI-compatible 模型配置
SKILL_BUILDER_LLM_PROVIDER=OpenAI
SKILL_BUILDER_LLM_API_BASE=
SKILL_BUILDER_LLM_API_KEY=
SKILL_BUILDER_LLM_MODEL=
SKILL_BUILDER_LLM_TIMEOUT_SECONDS=120
SKILL_BUILDER_LLM_MAX_TOKENS=16384
SKILL_BUILDER_LLM_MAX_REQUEST_BYTES=524288
SKILL_BUILDER_LLM_REQUEST_HEADROOM_RATIO=0.8
SKILL_BUILDER_LLM_TEMPERATURE=0.2
SKILL_BUILDER_LLM_TOP_P=0.9

# 可选的分阶段模型配置；"auto" 表示不发送 enable_thinking。
SKILL_BUILDER_LLM_ENABLE_THINKING=auto
SKILL_BUILDER_LLM_SCENARIO_ENABLE_THINKING=false
SKILL_BUILDER_LLM_AUTHOR_ENABLE_THINKING=false
SKILL_BUILDER_LLM_REPAIR_ENABLE_THINKING=true
SKILL_BUILDER_LLM_SCENARIO_MAX_TOKENS=8192
SKILL_BUILDER_LLM_AUTHOR_MAX_TOKENS=12288
SKILL_BUILDER_LLM_REPAIR_MAX_TOKENS=8192

# Jiuwenbox 是独立沙箱服务。
SKILL_BUILDER_SANDBOX_ENABLED=true
SKILL_BUILDER_JIUWENBOX_URL=http://127.0.0.1:8321
SKILL_BUILDER_JIUWENBOX_TIMEOUT_SECONDS=30
SKILL_BUILDER_SANDBOX_COMMAND_TIMEOUT_SECONDS=120
SKILL_BUILDER_SANDBOX_IO_TIMEOUT_SECONDS=20
SKILL_BUILDER_SANDBOX_WRITE_TIMEOUT_SECONDS=30
SKILL_BUILDER_SANDBOX_KEEP=false

# 生命周期预算。Iteration 是单会话安全上限，不是重试次数。
SKILL_BUILDER_AGENT_TOTAL_TIMEOUT_SECONDS=1200
SKILL_BUILDER_AGENT_CHAT_TIMEOUT_SECONDS=120
SKILL_BUILDER_AGENT_EDIT_TIMEOUT_SECONDS=360
SKILL_BUILDER_AGENT_SCENARIO_TIMEOUT_SECONDS=240
SKILL_BUILDER_AGENT_AUTHOR_TIMEOUT_SECONDS=900
SKILL_BUILDER_AGENT_REPAIR_TIMEOUT_SECONDS=480
SKILL_BUILDER_AGENT_REPAIR_RESERVE_TIMEOUT_SECONDS=180
SKILL_BUILDER_AGENT_IDLE_TIMEOUT_SECONDS=240
SKILL_BUILDER_AGENT_CHAT_MAX_ITERATIONS=6
SKILL_BUILDER_AGENT_EDIT_MAX_ITERATIONS=12
SKILL_BUILDER_AGENT_SCENARIO_MAX_ITERATIONS=8
SKILL_BUILDER_AGENT_AUTHOR_MAX_ITERATIONS=32
SKILL_BUILDER_AGENT_REPAIR_MAX_ITERATIONS=12
SKILL_BUILDER_AUTHOR_SELF_CHECK_MAX_RUNS=4
SKILL_BUILDER_MAX_REPAIR_ATTEMPTS=1

# 启发式 finding 默认只诊断；类型化契约失败仍是硬门禁。
SKILL_BUILDER_CAPABILITY_GATE_MODE=shadow
SKILL_BUILDER_DOCUMENTATION_GATE_MODE=shadow
SKILL_BUILDER_OFFLINE_PROTOCOL_GATE_MODE=shadow

# 可选 Playwright 材料录屏；这些配置不会启用生成 Skill 的浏览器验证。
# 先安装：pip install 'openjiuwen-skill-builder[recording]'
# 再执行：python -m playwright install chromium
# 精简 Linux/容器：python -m playwright install --with-deps chromium
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WEB_RECORDING_HEADLESS=auto
WEB_RECORDING_DISPLAY=
WEB_RECORDING_XAUTHORITY=
WEB_RECORDING_DISPLAY_PROBE_TIMEOUT_SECONDS=3
WEB_RECORDING_WINDOW_WIDTH=1280
WEB_RECORDING_WINDOW_HEIGHT=860
