<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>com.openjiuwen</groupId>
  <artifactId>adapter-versatile-agent-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>adapter-versatile-agent-java</name>
  <description>
    Standalone A2A process that proxies A2A requests to a remote Versatile REST
    workflow API. Reuses agent-runtime VersatileAgentHandler so that
    non-result nodes stream through to the caller (Target.USER), missing End
    nodes raise an interruption, and the result node feeds back to the LLM
    (Target.LLM).
  </description>

  <url>https://gitcode.com/openJiuwen/agent-solution</url>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>liubin</id>
      <name>liubin</name>
      <email>nickylba.liubin@huawei.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://gitcode.com/openJiuwen/agent-solution.git</connection>
    <developerConnection>scm:git:git@gitcode.com:openJiuwen/agent-solution.git</developerConnection>
    <url>https://gitcode.com/openJiuwen/agent-solution</url>
  </scm>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <agent-runtime-java.version>0.1.2</agent-runtime-java.version>
    <agent-runtime-ext-java.version>0.1.0</agent-runtime-ext-java.version>
    <!-- Tomcat CVE override（高于 Boot 4.0.7 的 11.0.22，保留） -->
    <tomcat.version>11.0.24</tomcat.version>
    <!-- A 桶：覆盖 spring-boot-dependencies 4.0.7 BOM 同名属性以对齐 core 830。
         这些属性不在本 pom 内用 ${} 引用——由 Boot BOM 内部消费
         (consumer 设同名属性即覆盖 Boot 默认值，如 otel Boot 默认 1.55.0 → 覆盖为 1.64.0)。
         验证: dependency:tree 显示 otel 1.64.0、slf4j 2.0.12 等已对齐(非 Boot 默认)。
         机制见 Spring Boot 文档: Overriding Version Management。 -->
    <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
    <opentelemetry.version>1.64.0</opentelemetry.version>
    <pulsar.version>4.2.3</pulsar.version>
    <mockito.version>5.14.2</mockito.version>
    <byte-buddy.version>1.15.11</byte-buddy.version>
    <snakeyaml.version>2.2</snakeyaml.version>
    <slf4j.version>2.0.12</slf4j.version>
    <logback.version>1.5.37</logback.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <commons-codec.version>1.20.0</commons-codec.version>
    <postgresql.version>42.7.12</postgresql.version>
    <mysql.version>9.7.0</mysql.version>
    <h2.version>2.2.224</h2.version>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <lombok.version>1.18.32</lombok.version>
    <log4j2.version>2.26.1</log4j2.version>
    <kotlin.version>2.4.10</kotlin.version>

    <!-- C 桶：Boot 不管/管理值非 core，显式 pin 防漂移 -->

    <gson.version>2.11.0</gson.version>

    <protobuf.version>4.33.2</protobuf.version>
    <!-- jackson-databind/core 显式 pin（与 jackson-2-bom 2.21.5 一致，CVE 历史 pin 保留） -->
    <jackson.version>2.21.5</jackson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- C 桶：Boot 不管/管理值非 core，显式 pin 防漂移（同 edp-agent-java） -->
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-service-app</artifactId>
      <version>${agent-runtime-java.version}</version>
    </dependency>

    <dependency>
      <groupId>com.openjiuwen</groupId>
      <artifactId>agent-service-adapters-versatile</artifactId>
      <version>${agent-runtime-ext-java.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- 显式声明 Jackson 2.x 版本，覆盖传递依赖的 2.21.2，修复 5 个 CVE -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.openjiuwen.versatile.VersatileAgentApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>net.revelc.code.formatter</groupId>
        <artifactId>formatter-maven-plugin</artifactId>
        <version>2.23.0</version>
        <configuration>
          <configFile>${project.basedir}/../.devtools/eclipse-java-formatter.xml</configFile>
          <includes>
            <include>**/*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
      central-release: activate with -Pcentral-release to attach -sources/-javadoc jars and
      GPG-sign all artifacts for manual upload to Maven Central. Not active by default (GPG
      would prompt on every build). Duplicated across the four publishing poms because they
      share no common internal parent by design — bump plugin versions in all four together.
  -->
  <profiles>
    <profile>
      <id>central-release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.7.0</version>
            <configuration>
              <encoding>UTF-8</encoding>
              <charset>UTF-8</charset>
              <docencoding>UTF-8</docencoding>
              <doclint>all,-missing</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
