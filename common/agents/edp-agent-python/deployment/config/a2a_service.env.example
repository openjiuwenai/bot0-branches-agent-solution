# ── 服务基本信息 ──────────────────────────────────────────────
APP_NAME="A2A Service"

# ── Redis（客户侧已有，按实际地址填写）──────────────────────
# 同一 Docker 网络：REDIS_HOST=<redis 容器/服务名>
# Linux 宿主机 Redis：REDIS_HOST=172.17.0.1（默认网桥）
# macOS/Windows 宿主机 Redis：REDIS_HOST=host.docker.internal
# 远程 Redis 集群：REDIS_HOST=<IP 或 DNS>
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=1800
REDIS_CHECKPOINTER_TTL_MINUTES=60

# ── 启动协调（多实例 Redis 锁；单实例部署保持默认即可）──────
BOOTSTRAP_COORDINATION_ENABLED=False
BOOTSTRAP_LOCK_NAME=a2a_global_bootstrap
BOOTSTRAP_LOCK_TTL_SEC=180
BOOTSTRAP_WAIT_TIMEOUT_SEC=300
BOOTSTRAP_POLL_INTERVAL_SEC=1.0

# ── 入口限流（单实例/每 IP / 全局）──────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=120
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=30

# ── VersatileAdapter 内部地址（单容器方案：同容器 localhost）──
VERSATILE_ADAPTER_URL=http://localhost:8091

# ── FastAPI ───────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8090
FASTAPI_DEBUG=False
FASTAPI_WORKERS=1

# ── 日志 ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/a2a_service.log

# ── LLM 网关（按企业环境填写）────────────────────────────
PLANNING_AGENT_MODEL_NAME=
PLANNING_AGENT_MODEL_API_KEY=
PLANNING_AGENT_MODEL_BASE_URL=
PLANNING_AGENT_MODEL_TIMEOUT=120
SKILL_LLM_TLS_VERIFY=false

# ── LLM 自定义请求头（可选，按网关要求）───────────────────
# 值有内容时，header 名变量必须填写，否则启动报错
PLANNING_AGENT_MODEL_TOKEN=
PLANNING_AGENT_MODEL_TOKEN_HEADER=
PLANNING_AGENT_MODEL_USER_ID=
PLANNING_AGENT_MODEL_USER_ID_HEADER=
PLANNING_AGENT_MODEL_EXTRA_HEADERS=

# ── Agent 身份与限制 ─────────────────────────────────────
DPA_AGENT_ID=edp_agent
DPA_AGENT_NAME="EDP Agent"
DPA_MAX_ITERATIONS=30

# ── 记忆功能使能开关 ──────────────────────────────────────────────────────────
DPA_MEMORY_ENABLED=false
DPA_MEMORY_ENABLE_USER_PROFILE=false
DPA_MEMORY_ENABLE_SEMANTIC_MEMORY=false
DPA_MEMORY_ENABLE_EPISODIC_MEMORY=false
DPA_MEMORY_ENABLE_SUMMARY_MEMORY=false
DPA_MEMORY_VARIABLES_JSON=[{"name":"communication_style","description":"用户偏好的沟通风格"},{"name":"risk_tolerance","description":"用户风险承受偏好"},{"name":"investment_goal","description":"用户当前投资目标"}]

# ── Context Engine（滑动窗口）──────────────────────────────────────────────
DPA_CONTEXT_ENGINE_ENABLED=false
DPA_CONTEXT_ENGINE_MAX_CONTEXT_MESSAGE_NUM=200
DPA_CONTEXT_ENGINE_DEFAULT_WINDOW_ROUND_NUM=10
DPA_CONTEXT_ENGINE_ENABLE_RELOAD=false

# ── Context Compression（DialogueCompressor）──────────────────────────────
DPA_DIALOGUE_COMPRESSION_ENABLED=false
DPA_DIALOGUE_COMPRESSION_TOKENS_THRESHOLD=10000
DPA_DIALOGUE_COMPRESSION_TARGET_TOKENS=1500
DPA_DIALOGUE_COMPRESSION_KEEP_LAST_ROUND=false

# ── Versatile 工作流结果节点 ─────────────────────────────
va_workflow_result_node=ABCQAResponseNode

# MCP相关配置信息
# 鉴权Token信息
MCP_ACCESS_TOKEN=
# MCP名称
MCP_APP_NAME=
# MCP地址
MCP_MASTER_URL=
# MCP备用地址
MCP_STANDBY_URL=
# MCP超时
MCP_TIMEOUT=

# ── DPA Memory ──────────────────────────────────────────────────────────────
DPA_MEMORY_IDLE_FLUSH_TIMEOUT_SECOND=600
DPA_MEMORY_PENDING_FLUSH_CHARS_THRESHOLD=20000

# GAUSS（结构化记忆 ）
DPA_MEMORY_GAUSS_HOST=
DPA_MEMORY_GAUSS_PORT=8000
DPA_MEMORY_GAUSS_USER=root
DPA_MEMORY_GAUSS_PASSWORD=
DPA_MEMORY_GAUSS_DATABASE=postgres

# Redis（KV记忆 共用系统redis）

# ELASTICSEARCH（向量记忆）
DPA_MEMORY_ELASTICSEARCH_HOST=
DPA_MEMORY_ELASTICSEARCH_USER=""
DPA_MEMORY_ELASTICSEARCH_PASSWORD= ""

# Embedding
DPA_MEMORY_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
DPA_MEMORY_EMBEDDING_API_BASE=http://xxxxx/v1/embeddings
DPA_MEMORY_EMBEDDING_API_KEY=sk-xxxxxx
NO_PROXY=
no_proxy=

# Embedding 鉴权（可选）
DPA_MEMORY_EMBEDDING_TOKEN=
DPA_MEMORY_EMBEDDING_TOKEN_HEADER=
DPA_MEMORY_EMBEDDING_USER_ID=
DPA_MEMORY_EMBEDDING_USER_ID_HEADER=
DPA_MEMORY_EMBEDDING_EXTRA_HEADERS=

# Memory LLM
DPA_MEMORY_LLM_PROVIDER=OpenAI
DPA_MEMORY_LLM_API_BASE=http://xxxxx:4000/v1
DPA_MEMORY_LLM_API_KEY=sk-xxxxx
DPA_MEMORY_LLM_MODEL_NAME=qwen3-next
DPA_MEMORY_LLM_VERIFY_SSL=false
DPA_MEMORY_LLM_TIMEOUT_SECOND=600

# Memory LLM 鉴权（可选）
DPA_MEMORY_LLM_TOKEN=
DPA_MEMORY_LLM_TOKEN_HEADER=
DPA_MEMORY_LLM_USER_ID=
DPA_MEMORY_LLM_USER_ID_HEADER=
DPA_MEMORY_LLM_EXTRA_HEADERS=
