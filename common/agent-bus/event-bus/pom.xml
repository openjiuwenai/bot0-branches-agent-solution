<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openjiuwen</groupId>
    <artifactId>event-bus</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>event-bus</name>
    <description>Event-bus (forwarding) modules — two-hop governance relay + producer/consumer SDK</description>

    <properties>
        <event-bus.java.release>17</event-bus.java.release>
        <!-- 保留参数名(等价 javac -parameters):EventBusRelayConfiguration 的
             forwardRelayProducer/responseRelayProducer 按 bean 名(relayProducer)
             做参数名注入,否则与 defaultProducer 冲突(NoUniqueBeanDefinition)。
             spring-boot-starter-parent 默认开;本仓 plain parent 显式声明。 -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!-- 对齐 runtime develop 4.0.7（不降级） -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <flyway.version>11.19.1</flyway.version>
        <a2a-sdk.version>1.0.0.Final</a2a-sdk.version>
        <!-- A 桶：覆盖 spring-boot-dependencies 4.0.7 BOM 同名属性以对齐 core 830。
         这些属性不在本 pom 内用 ${} 引用——由 Boot BOM 内部消费
         (consumer 设同名属性即覆盖 Boot 默认值，如 otel Boot 默认 1.55.0 → 覆盖为 1.64.0)。
         验证: dependency:tree 显示 otel 1.64.0、slf4j 2.0.12 等已对齐(非 Boot 默认)。
         机制见 Spring Boot 文档: Overriding Version Management。 -->
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <opentelemetry.version>1.64.0</opentelemetry.version>
        <pulsar.version>4.2.3</pulsar.version>
        <mockito.version>5.14.2</mockito.version>
        <byte-buddy.version>1.15.11</byte-buddy.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.37</logback.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <commons-codec.version>1.20.0</commons-codec.version>
        <postgresql.version>42.7.12</postgresql.version>
        <mysql.version>9.7.0</mysql.version>
        <h2.version>2.2.224</h2.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <lombok.version>1.18.32</lombok.version>
        <log4j2.version>2.26.1</log4j2.version>
        <kotlin.version>2.4.10</kotlin.version>

        <!-- C 桶：Boot 不管/管理值非 core，显式 pin 防漂移 -->

        <gson.version>2.11.0</gson.version>

        <protobuf.version>4.33.2</protobuf.version>
        <rocketmq-client.version>5.1.4</rocketmq-client.version>
        <mockwebserver.version>4.12.0</mockwebserver.version>
        <embedded-postgres.version>2.0.7</embedded-postgres.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>event-bus-spi</module>
        <module>event-bus-testkit</module>
        <module>event-bus-sdk</module>
        <module>event-bus-relay</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>event-bus-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>event-bus-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>event-bus-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
                <version>${a2a-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-http-client</artifactId>
                <version>${a2a-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>${rocketmq-client.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>io.github.aliyunmq</groupId>
                        <artifactId>rocketmq-rocksdb</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.grpc</groupId>
                        <artifactId>grpc-netty-shaded</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.squareup.okhttp3</groupId>
                        <artifactId>okhttp-jvm</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.squareup.okhttp3</groupId>
                        <artifactId>okhttp</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.squareup.okio</groupId>
                        <artifactId>okio</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>com.squareup.okio</groupId>
                        <artifactId>okio-jvm</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>mockwebserver</artifactId>
                <version>${mockwebserver.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- C 桶：Boot 不管/管理值非 core，显式 pin 防漂移（同 edp-agent-java） -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${event-bus.java.release}</release>
                        <!-- 保留参数名:EventBusRelayConfiguration 的 forwardRelayProducer/responseRelayProducer
                             按 bean 名(relayProducer)做参数名注入,无 -parameters 则与 defaultProducer 冲突。
                             spring-boot-starter-parent 默认开启;本仓用 plain parent 故显式声明。 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
