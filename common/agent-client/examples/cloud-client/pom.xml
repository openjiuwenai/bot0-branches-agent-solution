<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      独立多模块工程（无 parent），可脱离主 reactor 单独构建：
        cd agent-client/examples/cloud-client
        mvn -q clean package
        java -jar verification-app/target/verification-app.jar   # 退出码 0 = 全部断言通过

      交付边界（这是本次需求的核心诉求之一）：
        · agent-client-sdk  —— ★ SDK 交付物（api / *.spi / internal / transport）。真实 SDK 只发布这一件。
        · mock-gateway      —— ◇ 仅用于 JVM 验证：用纯 JDK HttpServer 模拟 gateway+runtime 的 A2A 入口，
                                 不在 SDK 交付范围内，物理上是独立 module，SDK 对它零依赖。
        · verification-app  —— ◇ 仅用于 JVM 验证：注册本地工具并发起真实 HTTP 调用打到 mock-gateway，
                                 用退出码表达成败，是"可执行验收用例"，不在 SDK 交付范围内。

      JDK 17 基线：以 <release>17</release> 约束 API 与字节码（本机可为更高 JDK，用 release=17 交叉编译）。
    -->
    <groupId>com.huawei.ascend.client.example</groupId>
    <artifactId>cloud-client-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>agent-client cloud-client (multi-module)</name>
    <description>
        Refactored runnable prototype of the proposed agent-client SDK, aligned with
        version-scope FEAT-006 / FEAT-007 and L2 Feat-Func-006 / Feat-Func-007
        (wire aligned with runtime Feat-Func-009). Split into SDK deliverable +
        verification-only mock gateway + verification-only self-check app.
    </description>

    <modules>
        <module>agent-client-sdk</module>
        <module>mock-gateway</module>
        <module>verification-app</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.17.3</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.huawei.ascend.client.example</groupId>
                <artifactId>agent-client-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.huawei.ascend.client.example</groupId>
                <artifactId>mock-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
