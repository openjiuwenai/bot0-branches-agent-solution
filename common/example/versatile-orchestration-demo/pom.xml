<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openjiuwen.example</groupId>
    <artifactId>versatile-orchestration-demo</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>versatile-orchestration-demo</name>
    <description>OpenJiuwen (agent-solution) re-implementation of workflow-calls + edpa gateway</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <modules>
        <module>adapter</module>
        <module>plan-agent</module>
        <module>gateway</module>
        <module>expense-review</module>
        <module>expense-review-main</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <agent-runtime-java.version>0.1.2</agent-runtime-java.version>
        <agent-runtime-ext-java.version>0.1.0</agent-runtime-ext-java.version>
        <protobuf-java.version>4.33.2</protobuf-java.version>
        <!-- A 桶 properties：Boot-property override（对齐 runtime 0.1.2 / core 0.1.15） -->
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.37</logback.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <byte-buddy.version>1.15.11</byte-buddy.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <commons-codec.version>1.20.0</commons-codec.version>
        <postgresql.version>42.7.12</postgresql.version>
        <h2.version>2.2.224</h2.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <pulsar.version>4.2.3</pulsar.version>
        <lombok.version>1.18.32</lombok.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- import runtime BOM：A 桶 + C 桶 + openjiuwen 全部版本管理（BOM import 时用 BOM 自己的 properties 解析 ${...}） -->
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-runtime-java</artifactId>
                <version>0.1.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-spec</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-app</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-adapters-agentcore</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-adapters-versatile</artifactId>
                <version>${agent-runtime-ext-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-adapters-agentcore-ext</artifactId>
                <version>${agent-runtime-ext-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-app-custom-rest</artifactId>
                <version>${agent-runtime-ext-java.version}</version>
            </dependency>
            <!-- Force the protobuf runtime that a2a-java's gencode (protoc 4.33.2) requires, overriding
                 the older 3.25.5 that agent-core-java + grpc-protobuf pull in transitively. -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
