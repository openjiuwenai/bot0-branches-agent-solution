# agent-client-demo 独立 Docker 部署配置
#
# 使用方法：
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   vi deploy/.env
#
# 规则：KEY=value，等号两侧不要加空格，不要加引号。
# deploy/.env 已被仓库根 .gitignore 忽略（*.env），禁止提交。

# ── 部署脚本控制项 ────────────────────────────────────────────
# 生产环境建议改成版本号或提交号标签，例如 agent-client-demo:0.1.0-20260714；
# 不建议长期使用 latest，因为它无法准确审计部署了哪个版本。
ACD_IMAGE=agent-client-demo:0.1.0
ACD_CONTAINER=agent-client-demo
ACD_HOST_PORT=8080

# ── 运行模式 ──────────────────────────────────────────────────
# CLI     ：运行 CLI 自检，跑完即退出，退出码 0=全部断言通过、非 0=失败（推荐，适合 CI/容器门禁）。
# UI      ：打开浏览器验证控制台（看板），常驻不退出，便于不熟悉 Java 的人员观察断言细节。
# EXTERNAL：verification-app 连接外部 gateway（由 AGENT_GATEWAY_URL 指定）做联调验证，
#           跑完即退出，退出码表达成败。
ACD_RUN_MODE=CLI

# ── 外接 gateway（仅 EXTERNAL 模式必填）────────────────────────
# verification-app 通过此地址访问外部 gateway。给的是 baseUrl（不含 /a2a）；
# SDK 检测到未含 /a2a 时会自动在末尾追加 /a2a。若 gateway 入口路径就是 /a2a，
# 可直接写完整地址。每个请求会带 Authorization: Bearer mock-token。
# CLI/UI 模式下此变量不生效（UI 模式下由页面动态指定，CLI 模式内嵌启动 mock-gateway）。
AGENT_GATEWAY_URL=

# ── UI 模式端口（仅 UI 模式生效）──────────────────────────────
# 注意：当前 VerificationUiServer 硬编码绑定 127.0.0.1，容器内 UI 无法通过 -p 端口映射
# 从宿主机访问。UI 模式部署时需配合 --network host（详见 README 第 5 节）。
UI_PORT=9090
