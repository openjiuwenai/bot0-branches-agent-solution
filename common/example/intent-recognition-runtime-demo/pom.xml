<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.openjiuwen.example</groupId>
    <artifactId>intent-recognition-runtime-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>intent-recognition-runtime-demo</name>
    <description>Runtime demos for intent recognition through ReAct Agent and Workflow</description>

    <modules>
        <module>demo-support</module>
        <module>react-agent-runtime</module>
        <module>workflow-runtime</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <agent-core-java.version>0.1.13</agent-core-java.version>
        <agent-core-ext-java.version>0.1.0-SNAPSHOT</agent-core-ext-java.version>
        <agent-runtime-java.version>0.1.0</agent-runtime-java.version>
        <agent-runtime-ext-java.version>0.1.0-SNAPSHOT</agent-runtime-ext-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openjiuwen.example</groupId>
                <artifactId>intent-recognition-demo-support</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
