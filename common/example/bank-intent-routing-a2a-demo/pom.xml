<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.openjiuwen.example</groupId>
    <artifactId>bank-intent-routing-a2a-demo</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>bank-demo-common</module>
        <module>intent-agent-runtime</module>
        <module>balance-agent-runtime</module>
        <module>transfer-agent-runtime</module>
        <module>wealth-advisor-agent-runtime</module>
        <module>wealth-purchase-agent-runtime</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <agent-runtime-java.version>0.1.1.post1</agent-runtime-java.version>
        <agent-runtime-ext-java.version>0.1.0</agent-runtime-ext-java.version>
        <agent-core-java.version>0.1.14.post1</agent-core-java.version>
        <agent-core-ext-intent-suite.version>0.1.0</agent-core-ext-intent-suite.version>
        <protobuf.version>4.33.2</protobuf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openjiuwen.example</groupId>
                <artifactId>bank-demo-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
