# LLM intent demo — example environment.
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored (see repo-root .gitignore) — NEVER commit real API keys.
# Both `scripts/cli_llm_intent.py start` and `scripts/local-e2e-llm-intent.sh`
# consume these. Real environment variables take precedence over `.env`, so you
# can still override a single run with `LLM_MODEL=... python3 ...`.

# --- L1/L2 intent classification (OpenAI-compatible endpoint) ---
# Reference: apiconfig.json (智谱 GLM glm-5.2). Keys come ONLY from env/.env.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_MODEL=glm-5.2

# --- Agent B (DeepAgent downstream) ---
# Defaults to the LLM_* values above when left unset, so a single config drives
# both classification and the downstream DeepAgent. Uncomment to diverge.
#DEEPSEEK_API_KEY=
#DEEPSEEK_BASE_URL=
#DEEPSEEK_MODEL=

# --- Process ports (optional overrides; defaults shown) ---
#GATEWAY_PORT=8084
#L1_PORT=8081
#L2_HOTEL_PORT=8082
#L2_FLIGHT_PORT=8086
#AGENT_B_HOTEL_PORT=18191
#AGENT_B_FLIGHT_PORT=18192

# --- Set to 1 to skip `mvn package` when jars already exist ---
#SKIP_BUILD=1
