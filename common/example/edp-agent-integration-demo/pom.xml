<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================ -->
    <!-- 客户集成示例：将 edp-agent-engine 作为 Maven 依赖嵌入自有应用 -->
    <!-- ============================================================ -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.customer</groupId>
    <artifactId>customer-agent-app</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <edp-agent-engine.version>0.1.0</edp-agent-engine.version>
        <agent-core-java.version>0.1.14.post1</agent-core-java.version>
        <agent-runtime-java.version>0.1.1.post1</agent-runtime-java.version>
    </properties>

    <dependencies>
        <!-- ============================================================ -->
        <!-- EDPAgent 引擎依赖（plain JAR，非 fat jar）                    -->
        <!-- 前置条件：edp-agent-engine 及 OpenJiuwen 三件套已在本地仓库  -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>edp-agent-engine</artifactId>
            <version>${edp-agent-engine.version}</version>
        </dependency>

        <!-- OpenJiuwen agent-core-java（提供 AgentRail/DeepAgentRail/Session 等 SPI） -->
        <!-- 必须使用 JDK17 构建的 0.1.14，切勿改用旧的裸 0.1.12（部分仓库为缺包的旧构建），会导致编译失败 -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-core-java</artifactId>
            <version>${agent-core-java.version}</version>
            <exclusions>
                <!-- ========== A 组：RAG/检索相关 ========== -->
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.milvus</groupId>
                    <artifactId>milvus-sdk-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.alibaba</groupId>
                    <artifactId>dashscope-sdk-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.pdfbox</groupId>
                    <artifactId>pdfbox</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.pgvector</groupId>
                    <artifactId>pgvector</artifactId>
                </exclusion>
                <!-- ========== B 组：Memory 相关 ========== -->
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcprov-jdk18on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcpkix-jdk18on</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.bouncycastle</groupId>
                    <artifactId>bcutil-jdk18on</artifactId>
                </exclusion>
                <!-- ========== C 组：其他重型依赖 ========== -->
                <exclusion>
                    <groupId>org.apache.pulsar</groupId>
                    <artifactId>pulsar-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-netty-shaded</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.openai</groupId>
                    <artifactId>openai-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-sender-grpc-managed-channel</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- OpenJiuwen agent-service-app（A2A Runtime） -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-service-app</artifactId>
            <version>${agent-runtime-java.version}</version>
        </dependency>

        <!-- OpenJiuwen agent-service-adapters-agentcore-ext（扩展适配器） -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-service-adapters-agentcore-ext</artifactId>
            <version>0.1.0</version>
            <exclusions>
                <exclusion>
                    <groupId>com.openjiuwen</groupId>
                    <artifactId>agent-core-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- DFX-001 OTel 轨迹上报（runtime ext middleware/otel）运行时必需。
             禁止排除/删除：缺失时 otel.enabled=true 启动即 NoClassDefFoundError。
             opentelemetry-exporter-sender-jdk / sender-grpc-managed-channel 由本依赖传递引入，无需单独声明。 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- OpenJiuwen agent-service-spec（SPI 接口） -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-service-spec</artifactId>
            <version>${agent-runtime-java.version}</version>
        </dependency>

        <!-- Custom REST SPI — 提供 CustomRestProtocolAdapter 接口，用于 ABCDE 网关协议适配 -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-service-app-custom-rest</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- Versatile 适配器 — 提供 call_versatile 工具，用于调用外部 Versatile 工作流（理财产品推荐等） -->
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>adapter-versatile-agent-java</artifactId>
            <version>0.1.0</version>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Data Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Jackson YAML（governance YAML 解析） -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Protobuf（统一版本，避免 protobuf-java 3.x 与 protobuf-java-util 4.x 冲突） -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.33.2</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件：将客户应用打成可执行 fat jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
