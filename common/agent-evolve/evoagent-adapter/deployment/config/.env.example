# EvoAgentAdapter 部署配置
# 使用方法：复制为 .env 并按需修改
#   cp .env.example .env && vim .env
#
# 启动：./start.sh --build   （首次启动需 --build 构建镜像）
# 停止：./stop.sh

# ===== 必填：主机路径（多 Agent 策略 A：公共父目录）=====
# 所有业务 Agent 的日志父目录（挂载到容器 /data/logs，只读）。
# 每个业务 Agent 的日志放在其子目录，如 /var/log/agents/edp_agent、.../hr_agent。
# agent_adapter_config.yaml 中 per-agent log_dir 写 /data/logs/{name} 对应此处的 {name} 子目录。
HOST_LOG_ROOT=/var/log/agents

# 所有业务 Agent 的 skills 父目录（挂载到容器 /data/skills，读写）。
# 每个业务 Agent 的 skills 放在其子目录，如 /opt/agents/skills/edp_agent。
# per-agent skills_dir 写 /data/skills/{name} 对应此处的 {name} 子目录。
HOST_SKILLS_ROOT=/opt/agents/skills

# 所有业务 Agent managed-doc 的公共父目录（挂载到容器 /data/agents，读写）。
# AgentRule.md 必须与业务 Agent 容器挂载同一份宿主机文件。
# 例如 YAML path=/data/agents/edp_agent/AgentRule.md 对应：
#   ${HOST_AGENTS_ROOT}/edp_agent/AgentRule.md
HOST_AGENTS_ROOT=/opt/agents/runtime

# Adapter 输出数据持久化目录（挂载到容器 /app/data，读写）
# 存储 offsets、output 归档等运行时数据
HOST_OUTPUT_DIR=/opt/agent-adapter/data

# Adapter 配置文件持久化路径（挂载到容器 /app/agent_adapter_config.yaml，读写）
# 热更新（CRUD /api/v1/config/agents）写入此文件，跨容器重建不丢失
# start.sh 首次启动时若该文件不存在，会从镜像内模板自动 seed；已存在则不覆盖
# docker-compose 部署时需在 up 前手动 cp 模板到此路径（start.sh 会自动 seed，compose 不会）
HOST_CONFIG_FILE=/opt/agent-adapter/agent_adapter_config.yaml

# ===== 可选：managed-doc Docker restart =====
# 默认关闭。设为 true 后 start.sh 才会挂载 Docker socket，使 restart_cmd 中的
# `docker restart <container>` 可用。Docker socket 具有宿主机 root 等价权限。
ADAPTER_ENABLE_DOCKER_RESTART=false
HOST_DOCKER_SOCKET=/var/run/docker.sock

# agent_adapter_config.yaml 的 extra_headers 可用 ${ADAPTER_AGENT_TOKEN} 引用。
# 生产环境请由 Secret 注入；不需要鉴权时留空。
ADAPTER_AGENT_TOKEN=

# ===== 可选：Adapter 服务配置 =====
# 日志轮询间隔（秒）
ADAPTER_POLL_INTERVAL=60

# 首次启动读取位置：tail（只读新日志） | head（从头读历史日志）
ADAPTER_START_FROM=tail

# 输出文件清理策略
ADAPTER_OUTPUT_RETENTION_DAYS=30
ADAPTER_OUTPUT_MAX_FILES=2000
ADAPTER_OUTPUT_MAX_FILE_SIZE=20MB

# 截断后目标占比（file_size ≈ threshold × ratio）
ADAPTER_OUTPUT_TRIM_TARGET_RATIO=0.7

# 日志等级：DEBUG | INFO | WARNING | ERROR
ADAPTER_LOG_LEVEL=INFO

# HTTP 服务监听地址与端口（compose 端口映射亦读 ADAPTER_PORT）
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8900

# ── 以下为容器内/裸机路径（docker 部署一般无需改）──
# log_dir / skills_root 在 docker 下由 compose 注入为 /data/logs、/data/skills
# （与下方 HOST_* 挂载目标对齐）。裸机运行可在此覆盖。
# ADAPTER_LOG_DIR=logs
# ADAPTER_SKILLS_ROOT=data/skills
# 活跃日志文件 glob；默认 process*.log
ADAPTER_LOG_PATTERN=process*.log
# START→END 配对超时（秒）
ADAPTER_PAIR_TIMEOUT=300
# 输出目录与 offset 状态文件（相对路径基于 adapter 根）
ADAPTER_OUTPUT_DIR=data/output
ADAPTER_OFFSET_FILE=data/offsets.json

# ===== 可选：Agent 轨迹采集（基于 OTel）=====
# 轨迹获取模式：
#   log      —— 读归档日志（默认，零外部依赖）
#   standard —— 读 collector 侧的 PG + Kafka（需 collector 已部署且网络可达）
# 切 standard 时需同时设 ADAPTER_NETWORK（见下方说明）。
ADAPTER_TRACE_SOURCE=log

# 数据库类型（目前仅 postgres）
ADAPTER_DB_TYPE=postgres

# PostgreSQL 连接（standard 模式读 collector 落库的轨迹）
ADAPTER_PG_HOST=postgres
ADAPTER_PG_PORT=5432
ADAPTER_PG_DB=agent_adapter
ADAPTER_PG_USER=otel_user
ADAPTER_PG_PASSWORD=otel_password

# Kafka 消费（standard 模式从 collector 的 OTLP trace topic 消费）
ADAPTER_KAFKA_BROKERS=kafka:9092
ADAPTER_KAFKA_TOPIC=otlp_traces
ADAPTER_KAFKA_GROUP=agent-adapter

# GET /traces/{conv} 等根 span 的服务端短等待秒数（standard 模式；设计 §7: 5s 上报 + 余量）
ADAPTER_TRACE_WAIT_TIMEOUT=10.0

# ── 网络接入（仅 start.sh 拉起方式使用，compose 另见 docker-compose.yml 末尾注释）──
# 留空 = 默认 bridge 网络；standard 模式需设为 collector 所在网络（如 openjiuwen-net），
# 以解析 kafka / postgres 容器别名。compose 部署不读此项，改用 networks 块。
ADAPTER_NETWORK=

# ===== 可选：多业务 Agent 配置（agent_adapter_config.yaml 的 agents[] 条目）=====
# 每个 agent 的字段由 <NAME>_<FIELD> 形式的环境变量传入（NAME 为 agent name 大写）。
# 对应 agent_adapter_config.yaml 中 ${<NAME>_<FIELD>:default} 占位；不设则取 yaml 默认。
# 增删 agent：在 .env 增删对应变量块 + 在 yaml agents 列表增删条目 + 宿主侧建好子目录。

# ── edp_agent ──
# agent_url: 业务 Agent 调用地址。
# 格式 http://<agent_ip>:<agent_port>，<agent_ip> 不可用 localhost/127.0.0.1（指向容器自身）。
# 业务 Agent 端口发布到宿主机时可用 http://host.docker.internal:8090
EDP_AGENT_URL=http://host.docker.internal:8090
EDP_AGENT_PROJECT_ID=proj_001
EDP_AGENT_ID=edp_agent
EDP_AGENT_TIMEOUT=300
# log_dir / skills_dir 为容器内绝对路径，对应宿主 HOST_LOG_ROOT/HOST_SKILLS_ROOT 下的子目录；
# docker 部署一般无需改。
EDP_AGENT_LOG_DIR=/data/logs/edp_agent
EDP_AGENT_SKILLS_DIR=/data/skills/edp_agent

# ── edp_agent skill backend（可选；默认 local 走宿主共享挂载）──
# 切 jiuwenbox 走沙箱文件 API 时：skill_backend=jiuwenbox + 填 jiuwenbox_url。
EDP_AGENT_SKILL_BACKEND=local
EDP_AGENT_JIUWENBOX_URL=
# sandbox_id 确定 EDPAgent 所在沙箱的方式：from_logs(默认) | fixed | list_ready
EDP_AGENT_SANDBOX_ID_RESOLVE=from_logs
# EDP_AGENT_SANDBOX_ID=            # sandbox_id_resolve=fixed 时必填
EDP_AGENT_REMOTE_SKILLS_DIR=/tmp/skills

# ── edp_agent managed-doc[0]（可选；默认 apply=file_only 仅写文件，惰性）──
# 列表第 0 条 doc 字段；加第 2 条在 yaml 增条目 + 用 EDP_AGENT_MDOC1_* 变量。
# 改 restart：EDP_AGENT_MDOC0_APPLY=restart + 设 ADAPTER_ENABLE_DOCKER_RESTART=true（挂 Docker socket）。
EDP_AGENT_MDOC0_KIND=agent_rule
EDP_AGENT_MDOC0_PATH=/data/agents/edp_agent/AgentRule.md
EDP_AGENT_MDOC0_ALLOW_ROOT=/data/agents/edp_agent
EDP_AGENT_MDOC0_MAX_CONTENT_BYTES=262144
EDP_AGENT_MDOC0_APPLY=file_only
EDP_AGENT_MDOC0_RESTART_CMD=docker restart edp_agent
EDP_AGENT_MDOC0_HEALTH_URL=http://host.docker.internal:8090/health

# ── other_agent ──
OTHER_AGENT_URL=
OTHER_AGENT_PROJECT_ID=proj_002
OTHER_AGENT_ID=other_agent
OTHER_AGENT_TIMEOUT=300
OTHER_AGENT_LOG_DIR=/data/logs/other_agent
OTHER_AGENT_SKILLS_DIR=/data/skills/other_agent

# ===== 可选：managed-doc defaults（仅当任一 agent 配了 managed_docs 且 apply=restart 时生效）=====
# profile / task_ttl_seconds 对应 agent_adapter_config.yaml 中 managed_doc_defaults 的
# ${ADAPTER_MDD_*:default} 占位（由 .env 提供 → resolver 在加载期展开）。
# profile 决定 burst（canary 训练，快速失败）vs single（人工单次）两套默认基线；
# 显式字段覆写优先于 profile 基线。task_ttl_seconds = 完成态任务保留时长（轮询窗口）。
# 其余 restart 参数（restart_cmd/health_url/max_attempts/…）在 yaml 内联，按需取消注释。
ADAPTER_MDD_PROFILE=burst
ADAPTER_MDD_TASK_TTL_SECONDS=600

# ===== 可选：SkillHub 对接（发布/拉取优化后的 Skill）=====
# 默认关闭。开启后 adapter 支持 list_hub_skills / publish_skill / pull_skill 等 action。
# ADAPTER_SKILLHUB_ENABLED=false
# ADAPTER_SKILLHUB_BASE_URL=http://127.0.0.1:8100
# ADAPTER_SKILLHUB_AUTH_MODE=system_token
# ADAPTER_SKILLHUB_TOKEN=your-system-admin-token
# ADAPTER_SKILLHUB_TOKEN_ENV=SKILLHUB_TOKEN
# ADAPTER_SKILLHUB_VERSION_STRATEGY=manual
