# DFW-RAG Web APP 环境变量示例
# 复制为 web/.env 并根据实际情况修改

# ========== Embedding 配置 ==========
# 可选值：openai / http / local / fallback
EMBEDDING_MODE=local

# local 模式下填写模型路径或 HuggingFace 模型名
EMBEDDING_MODEL=models/bge-small-zh-v1.5

# openai 模式下填写
# EMBEDDING_MODE=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# http 模式下填写
# EMBEDDING_MODE=http
# HTTP_EMBEDDING_URL=http://localhost:8000/embed
# HTTP_EMBEDDING_DIM=512

# ========== LLM 配置 ==========
# 可选值：openai / http
LLM_MODE=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1

# http 模式下填写
# LLM_MODE=http
# HTTP_LLM_URL=http://localhost:8000/chat
# HTTP_LLM_TOKEN=xxx

# ========== ChromaDB 配置 ==========
CHROMA_PERSIST_DIR=data/knowledge_qc/chroma

# ========== 其他配置 ==========
API_TIMEOUT=120
CHROMA_INIT_TIMEOUT=15
EMBEDDING_BATCH_SIZE=32
CHROMA_UPSERT_BATCH_SIZE=100
