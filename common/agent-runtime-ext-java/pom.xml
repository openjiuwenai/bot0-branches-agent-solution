<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openjiuwen</groupId>
    <artifactId>agent-runtime-ext-java</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>agent-runtime-ext-java</name>
    <description>OpenJiuwen Agent Runtime Java extension modules</description>

    <url>https://gitcode.com/openJiuwen/agent-solution</url>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>liubin</id>
            <name>liubin</name>
            <email>nickylba.liubin@huawei.com</email>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://gitcode.com/openJiuwen/agent-solution.git</connection>
        <developerConnection>scm:git:git@gitcode.com:openJiuwen/agent-solution.git</developerConnection>
        <url>https://gitcode.com/openJiuwen/agent-solution</url>
    </scm>

    <properties>
        <agent-runtime-ext.java.release>17</agent-runtime-ext.java.release>
        <agent-runtime-java.version>0.1.2</agent-runtime-java.version>
        <event-bus.version>0.1.0</event-bus.version>
        <a2a-sdk.version>1.0.0.Final</a2a-sdk.version>
        <agentscope.version>2.0.0</agentscope.version>
        <spring-boot.version>4.0.7</spring-boot.version>
        <!-- A 桶：覆盖 Boot 4.0.7 BOM 属性以对齐 core 830（机制同 agent-runtime-java develop） -->
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <opentelemetry.version>1.64.0</opentelemetry.version>
        <pulsar.version>4.2.3</pulsar.version>
        <mockito.version>5.14.2</mockito.version>
        <byte-buddy.version>1.15.11</byte-buddy.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.37</logback.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <commons-codec.version>1.20.0</commons-codec.version>
        <postgresql.version>42.7.12</postgresql.version>
        <mysql.version>9.7.0</mysql.version>
        <h2.version>2.2.224</h2.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <lombok.version>1.18.32</lombok.version>
        <log4j2.version>2.26.1</log4j2.version>
        <kotlin.version>2.4.10</kotlin.version>
        <!-- B 桶：junit/assertj 不 pin，靠 Boot 4.0.7 管 6.0.3/3.27.7 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>agent-service-spec-ext</module>
        <module>agent-service-app/agent-service-app-custom-rest</module>
        <module>agent-service-adapters/agent-service-adapters-versatile</module>
        <module>agent-service-adapters/agent-service-adapters-agentcore-ext</module>
        <module>agent-service-adapters/agent-service-adapters-agentscope</module>
    </modules>

    <profiles>
        <profile>
            <id>agent-service-bus-consumer</id>
            <modules>
                <module>agent-service-bus-consumer</module>
            </modules>
        </profile>
        <!--
            central-release: activate with -Pcentral-release to attach -sources/-javadoc jars and
            GPG-sign all artifacts for manual upload to Maven Central. Not active by default (GPG
            would prompt on every build). Duplicated across the four publishing poms because they
            share no common internal parent by design — bump plugin versions in all four together.
        -->
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.7.0</version>
                        <configuration>
                            <encoding>UTF-8</encoding>
                            <charset>UTF-8</charset>
                            <docencoding>UTF-8</docencoding>
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>event-bus-spi</artifactId>
                <version>${event-bus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>event-bus-sdk</artifactId>
                <version>${event-bus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-spec</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-adapters-agentcore</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-spec-ext</artifactId>
                <version>0.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-app</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-spec</artifactId>
                <version>${a2a-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-server-common</artifactId>
                <version>${a2a-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-jsonrpc-common</artifactId>
                <version>${a2a-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-client</artifactId>
                <version>${a2a-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-core-java</artifactId>
                <version>0.1.15</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <!-- C 桶：Boot 不管，显式 pin 防漂移（同 agent-runtime-java） -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.11.0</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.33.2</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>4.33.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${agent-runtime-ext.java.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>
