# 参考宿主与兼容入口的环境变量样例
#
# 用法
#   cp deploy/.env.example deploy/.env        # 填值。deploy/.env 已被仓库根 .gitignore 忽略，不要提交
#   set -a; . deploy/.env; set +a             # 由启动方装进进程环境（或容器的 --env-file deploy/.env）
#   python -m uvicorn host_app:app --host 0.0.0.0 --port 8090    # 参考宿主（第一、二部分）
#   python -m agent_runtime.bootstrap.legacy_compat              # 兼容入口，沿用存量 .env（第三部分）
#
# 本 runtime 不读 .env 文件——它是嵌入宿主的 SDK，只读已经进入进程的环境变量；
# 上游 Java 版同样如此（agent-runtime-java 的 .gitignore 只排除 .env，不解析它）。
#
# 格式
#   KEY=value，等号两侧不加空格，不写行内注释（--env-file 不剥行内注释，会把它当成值）。
#   含空格的值用 shell 加载时要加引号，用 --env-file 时不要加引号。
#   行首 `#KEY=value` 表示该项默认不设置、值为出厂默认或占位；去掉 `#` 即生效。
#
# 三部分各有各的读取方，互不越界
#   一、宿主旋钮          deploy/host_app.py                          单下划线 RUNTIME_*
#   二、runtime 配置       agent_runtime/bootstrap/config/loader.py    双下划线 OPENJIUWEN__SERVICE__*
#   三、存量 .env 的去向   agent_runtime/bootstrap/legacy_compat/      沿用 applications/a2a_service 的变量名
#
# 本文件与代码不漂移由判据锁住（agent_runtime/tests/test_deploy_env_example.py）：
#   第一部分的集合等于参考宿主实际读取的旋钮；第二部分每一项都绑得到配置字段；
#   第三部分的分组等于 env_bridge.py 的去向表；各组取值等于存量 .env.example 的出厂值。
# `# @section` 行是判据的分组标记，不要改动。


# ══════════════════════════════════════════════════════════════════════
# 一、宿主旋钮——deploy/host_app.py 读取
#     这些是参考宿主（受测装置）自己的参数，不是 runtime 的配置项。
#     真实宿主有自己的配置体系，这一部分只对本仓的参考宿主有意义。
# ══════════════════════════════════════════════════════════════════════
# @section host

# 服务身份。写进南向报文的会话上下文与 A2A 卡片，两处都对外可观察。
RUNTIME_AGENT_ID=mobile_bank_agent

# 监听端口。与存量默认值一致，替换时不需要改调用方配置。
RUNTIME_PORT=8090

# 对外基址，写进 A2A 卡片；远端调用方按卡片回连，写错即回连不上。
RUNTIME_SELF_URL=http://127.0.0.1:8090/a2a/

# 执行后端：fixture=确定性替身（契约档，无外部依赖）；agentcore=真实执行后端（贯通档）。
RUNTIME_BACKEND=fixture

# 替身的帧间延迟（秒）。只影响产帧节奏，不影响帧内容；关停排水一类用例要拉开它。
#RUNTIME_FIXTURE_DELAY_S=0

# 贯通档注册的工作流标识。
#RUNTIME_WORKFLOW_ID=blackbox_wf

# 回调入口的共享令牌。未配置即不构造回调件、回调入口一律拒绝——与生产默认一致。
#RUNTIME_CALLBACK_TOKEN=

# 共享存储。单机给连接串，集群给逗号分隔的节点；二者都不配则用进程内实现。
#RUNTIME_REDIS_URL=redis://127.0.0.1:6379/0
#RUNTIME_REDIS_NODES=
#RUNTIME_REDIS_PASSWORD=


# ══════════════════════════════════════════════════════════════════════
# 二、runtime 配置——ConfigLoader 读取
#     环境变量名由配置路径推出：openjiuwen.service.a.b → OPENJIUWEN__SERVICE__A__B，
#     层级分隔是双下划线（字段名本身常含单下划线）。全部配置项与默认值见 doc/configuration.md。
#     旧前缀 RUNTIME__A__B 仍被读取并逐键告警，两边都配时以新前缀为准。
#     参考宿主从环境变量读的是下列几段；versatile / bus / remote / state_store 四段
#     参考宿主不从环境变量读，写进 OPENJIUWEN__SERVICE__CONFIG_FILE 指向的配置文件。
#     口令类不进本样例：Redis 口令与技能中心令牌走配置文件密文或机密目录。
# ══════════════════════════════════════════════════════════════════════
# @section runtime

# 配置文件路径。参考宿主配了就读、没配就一份都不读；文件的根键是 openjiuwen.service。
#OPENJIUWEN__SERVICE__CONFIG_FILE=/etc/agent-runtime/runtime.yaml

# 凭据解密器实现指向。留空即内建透传；配了名字却发现不到，启动期直接失败。
#OPENJIUWEN__SERVICE__CREDENTIAL__DECRYPTOR=

# 生命周期：初始化失败是否终止启动；关停宽限秒数。
#OPENJIUWEN__SERVICE__LIFECYCLE__INIT_FAIL_FAST=true
#OPENJIUWEN__SERVICE__LIFECYCLE__SHUTDOWN_TIMEOUT_S=30

# 扩展点装配：键名即扩展点名，留空按优先级自动选取。
# 注意：这一段当前生产装配不消费（配置读得到、没人按它选实现，台账「配置段未接线」已登记待修），配了不生效。
#OPENJIUWEN__SERVICE__EXTENSIONS__HANDLER__IMPL=
#OPENJIUWEN__SERVICE__EXTENSIONS__CACHE__IMPL=

# 状态缓存（middleware 段）。endpoint_type 取 standalone 或 cluster；集群形态下 standalone 整段忽略。
# 集群节点是列表，环境变量表达不了，写进配置文件的 middleware.cluster.nodes。
#OPENJIUWEN__SERVICE__MIDDLEWARE__ENDPOINT_TYPE=standalone
#OPENJIUWEN__SERVICE__MIDDLEWARE__STANDALONE__HOST=127.0.0.1
#OPENJIUWEN__SERVICE__MIDDLEWARE__STANDALONE__PORT=6379
#OPENJIUWEN__SERVICE__MIDDLEWARE__STANDALONE__DATABASE=0
#OPENJIUWEN__SERVICE__MIDDLEWARE__STANDALONE__TIMEOUT_MS=3000
#OPENJIUWEN__SERVICE__MIDDLEWARE__CLUSTER__TIMEOUT_MS=3000
#OPENJIUWEN__SERVICE__MIDDLEWARE__RETRY__MAX_ATTEMPTS=3
#OPENJIUWEN__SERVICE__MIDDLEWARE__RETRY__BASE_DELAY_S=0.05
#OPENJIUWEN__SERVICE__MIDDLEWARE__RETRY__MAX_DELAY_S=1.0

# 技能中心（skill_hub 段）。总开关默认关闭：不配置时整条链路不装配，行为与没有本特性时逐字相同。
#OPENJIUWEN__SERVICE__SKILL_HUB__ENABLED=false
#OPENJIUWEN__SERVICE__SKILL_HUB__ENDPOINT=
#OPENJIUWEN__SERVICE__SKILL_HUB__AUTH_TYPE=bearer
#OPENJIUWEN__SERVICE__SKILL_HUB__ENCRYPTED_TOKEN=
#OPENJIUWEN__SERVICE__SKILL_HUB__LOCAL_DIR=/var/lib/agent-runtime/skills
#OPENJIUWEN__SERVICE__SKILL_HUB__PROVIDER=
#OPENJIUWEN__SERVICE__SKILL_HUB__FETCH__CONCURRENCY=4
#OPENJIUWEN__SERVICE__SKILL_HUB__FETCH__PAGE_SIZE=200
#OPENJIUWEN__SERVICE__SKILL_HUB__FETCH__CONNECT_TIMEOUT_S=10.0
#OPENJIUWEN__SERVICE__SKILL_HUB__FETCH__REQUEST_TIMEOUT_S=30.0
#OPENJIUWEN__SERVICE__SKILL_HUB__FETCH__DOWNLOAD_TIMEOUT_S=600.0
#OPENJIUWEN__SERVICE__SKILL_HUB__FETCH__MAX_EXTRACTED_BYTES=536870912
#OPENJIUWEN__SERVICE__SKILL_HUB__RETRY__MAX_ATTEMPTS=120
#OPENJIUWEN__SERVICE__SKILL_HUB__RETRY__INITIAL_DELAY_S=5.0
#OPENJIUWEN__SERVICE__SKILL_HUB__RETRY__PERIOD_S=30.0


# ══════════════════════════════════════════════════════════════════════
# 三、从 applications/a2a_service 升级：存量 .env 每一项的去向
#     兼容入口 python -m agent_runtime.bootstrap.legacy_compat 按存量变量名读取，
#     升级时 .env 原样保留、启动命令只改模块名（doc/upgrade-from-a2a-service.md）。
#     下面的分组与取值来自存量 .env.example 的出厂值；逐项依据见
#     internal/operate/ENV-MAPPING-FROM-A2A-SERVICE.md。
#     参考宿主 deploy/host_app.py 不读这一部分的任何名字。
# ══════════════════════════════════════════════════════════════════════

# ── 兼容入口自己的项。宿主工厂指向（模块:工厂名）默认是存量形态的宿主：参考宿主的装配 +
#    按存量导入名装载的宿主 Agent；宿主 Agent 的导入名默认 agents.EDPAgent（与存量 app.py 相同），
#    代码放在原来的位置 applications/a2a_service/agents/EDPAgent/ 并让该目录的上级在 PYTHONPATH 上。
#    设了 RUNTIME_BACKEND（fixture／agentcore）则改用参考宿主的内建后端，不装载宿主 Agent（验证用）。
# @section legacy-entry
#RUNTIME_LEGACY_APP=agent_runtime.bootstrap.legacy_compat.host:create_app
#RUNTIME_LEGACY_AGENT=agents.EDPAgent

# ── 承接（19 项）：本版按同名变量读，转写到本版配置路径。
#    REDIS_PASSWORD 本版收密文，升级前先加密；RUNTIME_DB_* 五项本版自动拼成连接串。
#    VA_WORKFLOW_RESULT_NODE 与 RUNTIME_DB_SQLITE_PATH 是存量 Settings 有、.env.example 未列的两项。
# @section legacy:mapped
APP_NAME=A2A Service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=180
VERSATILE_ADAPTER_URL=http://localhost:8091
VERSATILE_ADAPTER_TIMEOUT=57
#VA_WORKFLOW_RESULT_NODE=answer
MAX_CONCURRENT_SUB_AGENTS=3
MAX_CALL_DEPTH=3
RUNTIME_DB_ENABLED=false
RUNTIME_DB_TYPE=gaussdb
RUNTIME_DB_HOST=127.0.0.1
RUNTIME_DB_PORT=8000
RUNTIME_DB_NAME=postgres
RUNTIME_DB_USER=root
RUNTIME_DB_PASSWORD=
#RUNTIME_DB_SQLITE_PATH=

# ── 归宿主（19 项）：服务监听、日志、心跳、限流本来就不属于 runtime。
#    兼容入口自己扮演宿主时读 FASTAPI_*；其余读到即忽略、不告警。
#    心跳与限流要在你的接入层或网关补上（宿主义务 H-SERVE-6、H-SERVE-1）。
# @section legacy:host-owned
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8090
FASTAPI_DEBUG=False
FASTAPI_WORKERS=1
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION_SIZE=20 MB
LOG_RETENTION_DAYS=7
LOG_MAX_TOTAL_SIZE=500 MB
JIUWEN_LOG_BACKUP_COUNT=20
JIUWEN_LOG_MAX_BYTES=20 MB
JIUWEN_LOG_RETENTION_DAYS=7
JIUWEN_LOG_MAX_TOTAL_SIZE=500 MB
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=1800
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=120
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=30

# ── 归宿主 Agent（8 项）：EDPAgent 自己的运行参数，随 Agent 走，原样保留。读到即忽略、不告警。
# @section legacy:agent-owned
AES_MASTER_KEY=
DPA_AGENT_ID=edp_agent
SUB_AGENT_TIMEOUT_SECONDS=1800
MAX_PARALLEL_WORKFLOWS_PER_AGENT=3
WORKFLOW_TIMEOUT_SECONDS=900
ACTIVE_SCENARIO=AgentRule_Wealth_purchase
SANDBOX_URL=
SKILL_TARGET_PATH=/tmp

# ── 不承接（5 项）：存量的启动协调是空壳设施，承接换不到任何行为。设置了会打可见告警，建议删掉。
#    跨副本的一次性初始化用部署编排层的手段（一次性任务或初始化容器）。
# @section legacy:not-adopted
#BOOTSTRAP_COORDINATION_ENABLED=False
#BOOTSTRAP_LOCK_NAME=a2a_global_bootstrap
#BOOTSTRAP_LOCK_TTL_SEC=180
#BOOTSTRAP_WAIT_TIMEOUT_SEC=300
#BOOTSTRAP_POLL_INTERVAL_SEC=1.0

# ── 随宿主 Agent 走（81 项）：a2a_service 自己从不读它们，由 EDPAgent 与可观测设施读取，
#    与 runtime 换不换无关。留在你的 .env 里即可；本版既不读也不告警。分组沿用存量的注释。
# @section legacy:agent-only

# Redis 检查点过期
#REDIS_CHECKPOINTER_TTL_MINUTES=60

# OTel 轨迹上报（由 EDPAgent 运行时读取）
#OTEL_ENABLED=false
#OTEL_EXPORTER_TYPE=otlp
#OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317
#OTEL_SERVICE_NAME=edpagent
#OTEL_PROTOCOL=grpc
#OTEL_EXPORTER_HEADERS=
#OTEL_SAMPLE_RATE=1.0
#OTEL_REDACTION_ENABLED=false
#OTEL_MAX_ATTR_LENGTH=0
#OTEL_RESOURCE_ATTRIBUTES=

# LLM（上游保留字段；EDPAgent 不读这一组）
#LLM_PROVIDER=llm_OpenAI
#LLM_API_BASE=https://api.deepseek.com
#LLM_API_KEY=
#LLM_MODEL_NAME=deepseek-chat
#LLM_VERIFY_SSL=False
#LLM_USER_ID=
#LLM_TOKEN=

# LLM（EDPAgent 实际读取的一组）
#PLANNING_AGENT_MODEL_NAME=
#PLANNING_AGENT_MODEL_API_KEY=
#PLANNING_AGENT_MODEL_BASE_URL=
#PLANNING_AGENT_MODEL_TIMEOUT=120
#SKILL_LLM_TLS_VERIFY=false

# 企业内网 LLM 鉴权（值变量与 header 名变量成对填写）
#PLANNING_AGENT_MODEL_TOKEN=
#PLANNING_AGENT_MODEL_TOKEN_HEADER=
#PLANNING_AGENT_MODEL_USER_ID=
#PLANNING_AGENT_MODEL_USER_ID_HEADER=
#PLANNING_AGENT_MODEL_EXTRA_HEADERS=

# DPA Agent
#DPA_AGENT_NAME=EDP Agent
#DPA_MAX_ITERATIONS=30

# MCP
#MCP_ACCESS_TOKEN=
#MCP_APP_NAME=
#MCP_MASTER_URL=
#MCP_STANDBY_URL=
#MCP_TIMEOUT=

# 记忆与上下文开关
#DPA_MEMORY_ENABLED=false
#DPA_MEMORY_ENABLE_USER_PROFILE=false
#DPA_MEMORY_ENABLE_SEMANTIC_MEMORY=false
#DPA_MEMORY_ENABLE_EPISODIC_MEMORY=false
#DPA_MEMORY_ENABLE_SUMMARY_MEMORY=false
#DPA_MEMORY_VARIABLES_JSON=[{"name":"communication_style","description":"用户偏好的沟通风格"},{"name":"risk_tolerance","description":"用户风险承受偏好"},{"name":"investment_goal","description":"用户当前投资目标"}]

# Context Engine（滑动窗口）
#DPA_CONTEXT_ENGINE_ENABLED=false
#DPA_CONTEXT_ENGINE_MAX_CONTEXT_MESSAGE_NUM=200
#DPA_CONTEXT_ENGINE_DEFAULT_WINDOW_ROUND_NUM=10
#DPA_CONTEXT_ENGINE_ENABLE_RELOAD=false

# Context Compression
#DPA_DIALOGUE_COMPRESSION_ENABLED=false
#DPA_DIALOGUE_COMPRESSION_TOKENS_THRESHOLD=10000
#DPA_DIALOGUE_COMPRESSION_TARGET_TOKENS=1500
#DPA_DIALOGUE_COMPRESSION_KEEP_LAST_ROUND=false

# DPA Memory
#DPA_MEMORY_IDLE_FLUSH_TIMEOUT_SECOND=30
#DPA_MEMORY_PENDING_FLUSH_CHARS_THRESHOLD=20000

# GAUSS（结构化记忆）
#DPA_MEMORY_GAUSS_HOST=
#DPA_MEMORY_GAUSS_PORT=8000
#DPA_MEMORY_GAUSS_USER=root
#DPA_MEMORY_GAUSS_PASSWORD=
#DPA_MEMORY_GAUSS_DATABASE=postgres

# ELASTICSEARCH（向量记忆）
#DPA_MEMORY_ELASTICSEARCH_HOST=
#DPA_MEMORY_ELASTICSEARCH_USER=""
#DPA_MEMORY_ELASTICSEARCH_PASSWORD=""

# Embedding
#DPA_MEMORY_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
#DPA_MEMORY_EMBEDDING_API_BASE=http://xxxxx/v1/embeddings
#DPA_MEMORY_EMBEDDING_API_KEY=sk-xxxxxx
#NO_PROXY=
#no_proxy=

# Embedding 鉴权
#DPA_MEMORY_EMBEDDING_TOKEN=
#DPA_MEMORY_EMBEDDING_TOKEN_HEADER=
#DPA_MEMORY_EMBEDDING_USER_ID=
#DPA_MEMORY_EMBEDDING_USER_ID_HEADER=
#DPA_MEMORY_EMBEDDING_EXTRA_HEADERS=

# Memory LLM
#DPA_MEMORY_LLM_PROVIDER=OpenAI
#DPA_MEMORY_LLM_API_BASE=http://xxxxx:4000/v1
#DPA_MEMORY_LLM_API_KEY=sk-xxxxx
#DPA_MEMORY_LLM_MODEL_NAME=qwen3-next
#DPA_MEMORY_LLM_VERIFY_SSL=false
#DPA_MEMORY_LLM_TIMEOUT_SECOND=600

# Memory LLM 鉴权
#DPA_MEMORY_LLM_TOKEN=
#DPA_MEMORY_LLM_TOKEN_HEADER=
#DPA_MEMORY_LLM_USER_ID=
#DPA_MEMORY_LLM_USER_ID_HEADER=
#DPA_MEMORY_LLM_EXTRA_HEADERS=

# 场景激活与 Skill 注册模式
#DPA_SKILL_REGISTRATION_MODE=filtered
