# ============================================================
# Preset Importer 配置文件 (独立于 Agent Studio 工程)
# ------------------------------------------------------------
# 本文件包含数据导入工具所需的全部配置：
#   - 目标服务地址(studio-manager API)
#   - 数据库连接(直连写 t_app/t_agent_version)
#   - MinIO/OBS(改 agent IR JSON)
#   - 鉴权信息
# 修改本文件后直接运行 import-presets.py / setup-model-auth.py 即可。
# ============================================================

# === 目标 Agent Studio 服务 ===
MANAGER_PORT=
BASE_URL=
AUTH_TOKEN=testUser|0
PROJECT_ID=0

# === 运营/官方项目(让预置插件显示在插件市场 OFFICIAL) ===
OP_SVC_PROJECT_ID=0
OP_SVC_USER_ID=testUser
OP_SVC_TENANT_ID=0

# === 数据库(MariaDB) — 直连写 t_app/t_agent_version/t_tool 用 ===
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=agent-builder

# === MinIO(OBS) — 改 agent IR JSON 用 ===
OBS_HOST=
OBS_PORT=
MINIO_AK=
MINIO_SK=
MINIO_BUCKET=agent-builder

# === 预置数据源(默认用同目录 preset-data/) ===
# 如需指向其他目录，取消注释修改：
# PLUGINS_DIR=
# EXAMPLES_ZH=
